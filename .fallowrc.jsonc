{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreDependencies": [
    // The changelog script calls `git cliff`, which Fallow does not associate with git-cliff.
    "git-cliff",
    // Loaded by customRules in .markdownlint-cli2.jsonc, not a source import.
    "markdownlint-rule-relative-links"
  ]
}
