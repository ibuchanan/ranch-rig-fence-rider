{
  "name": "ranch-rig-fence-rider",
  "version": "0.0.0",
  "private": true,
  "description": "A SecretSpec-powered CLI wrapper for syncing secrets to Atlassian Forge environments.",
  "license": "Apache-2.0",
  "author": "ibuchanan",
  "type": "module",
  "bin": {
    "fence-rider": "src/index.ts"
  },
  "files": [
    "src",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun build --compile ./src/index.ts --outfile ./dist/fence-rider",
    "changelog": "git cliff --config cliff.toml --unreleased -o CHANGELOG.md",
    "check": "run-p --npm-path bun --print-label lint test:check",
    "clean": "rm -rf dist",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "run-p --npm-path bun --print-label \"lint:check:*\"",
    "lint:check": "biome lint",
    "lint:check:biome": "bun run lint:check",
    "lint:check:fallow": "bun run lint:fallow",
    "lint:check:format": "bun run format:check",
    "lint:check:typecheck": "bun run typecheck",
    "lint:docs": "markdownlint-cli2 \"**/*.md\" && cspell lint \"**/*.md\"",
    "lint:fallow": "FALLOW_TELEMETRY=off fallow --summary",
    "lint:fix": "biome lint --write",
    "lint:fix:biome": "biome lint --write",
    "prepare": "lefthook install || true",
    "release": "bash scripts/release.sh",
    "release:check": "bun run test && bun run typecheck",
    "test": "bun run --if-present test:native-gate && bun test --parallel --timeout 30000 --timings .test-timings.json --update-timings --pass-with-no-tests",
    "test:check": "FENCE_RIDER_REQUIRE_NATIVE=1 bun run test --only-failures",
    "test:coverage": "bun test --coverage --pass-with-no-tests",
    "test:integration": "bun run --if-present test:native-gate && bun test tests/integration --parallel --timeout 30000 --timings .test-timings.json --update-timings --pass-with-no-tests",
    "test:integration:fakes": "bun test tests/integration/fake-tools --parallel --timeout 30000 --pass-with-no-tests",
    "test:integration:native": "bun run --if-present test:native-gate && bun test tests/integration/real-secretspec --parallel --timeout 30000 --pass-with-no-tests",
    "test:native-gate": "bun tests/support/native-gate.ts",
    "test:unit": "bun test tests/unit --pass-with-no-tests",
    "test:watch": "bun test --watch --pass-with-no-tests",
    "todo": "git grep -n -I -F TO\"DO\" -- .; status=$?; if [ \"$status\" -eq 1 ]; then echo \"No TO\"\"DO markers found.\"; elif [ \"$status\" -ne 0 ]; then exit \"$status\"; fi",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "commander": "^15.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "cspell": "^10.4",
    "fallow": "^3.34",
    "fast-check": "^4.10",
    "git-cliff": "^2.14",
    "lefthook": "^2.2",
    "markdownlint-cli2": "^0.24",
    "markdownlint-rule-relative-links": "^5.1.4",
    "npm-run-all2": "^9.0",
    "typescript": "^5.9"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.3"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ]
}
