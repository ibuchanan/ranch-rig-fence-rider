{
  "name": "ranch-rig-fence-rider",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "license": "Apache-2.0",
  "author": "ibuchanan",
  "type": "module",
  "bin": {
    "fence-rider": "src/index.ts"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "files": [
    "src",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun build --compile ./src/index.ts --outfile ./dist/fence-rider",
    "changelog": "git cliff --config cliff.toml --unreleased -o CHANGELOG.md",
    "check": "run-p lint test:check",
    "clean": "rm -rf dist",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "run-p --npm-path bun --print-label \"lint:check:*\"",
    "lint:check:biome": "biome lint",
    "lint:check:fallow": "output=$(fallow --fail-on-issues 2>&1) || { status=$?; printf '%s\\n' \"$output\"; exit \"$status\"; }",
    "lint:check:format": "bun run format:check",
    "lint:check:typecheck": "bun run typecheck",
    "lint:docs": "markdownlint-cli2 \"**/*.md\" && cspell lint \"**/*.md\"",
    "lint:fix:biome": "biome lint --write",
    "prepare": "lefthook install || true",
    "test": "bun test --parallel --timeout 30000 --timings .test-timings.json --update-timings --pass-with-no-tests",
    "test:check": "bun run test --only-failures",
    "test:coverage": "bun test --coverage --pass-with-no-tests",
    "test:watch": "bun test --watch --pass-with-no-tests",
    "todo": "git grep -n -I -F TO\"DO\" -- .; status=$?; if [ \"$status\" -eq 1 ]; then echo \"No TO\"\"DO markers found.\"; elif [ \"$status\" -ne 0 ]; then exit \"$status\"; fi",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "cspell": "^10.4",
    "fallow": "^3.34",
    "fast-check": "^4.10",
    "git-cliff": "^2.14",
    "lefthook": "^2.2",
    "markdownlint-cli2": "^0.23",
    "npm-run-all2": "^9.0",
    "typescript": "^5.9"
  },
  "packageManager": "bun@1.4.3"
}
